language = Objective-C
package = br.com.codecacto.kmplib.cinterop.googleads

modules = GoogleMobileAds
compilerOpts = -framework GoogleMobileAds

---

#import <Foundation/Foundation.h>
#import <UIKit/UIKit.h>

// --- GADAdSize ---
struct GADAdSize {
    CGSize size;
};
typedef struct GADAdSize GADAdSize;

extern GADAdSize const GADAdSizeBanner;
extern GADAdSize const GADAdSizeLargeBanner;
extern GADAdSize const GADAdSizeFullBanner;
extern GADAdSize const GADAdSizeLeaderboard;

// --- GADRequest ---
@interface GADRequest : NSObject
+ (instancetype)request;
@end

// --- GADFullScreenPresentingAd protocol ---
@protocol GADFullScreenPresentingAd <NSObject>
@end

// --- GADFullScreenContentDelegate ---
@protocol GADFullScreenContentDelegate <NSObject>
@optional
- (void)adDidDismissFullScreenContent:(id<GADFullScreenPresentingAd>)ad;
- (void)ad:(id<GADFullScreenPresentingAd>)ad didFailToPresentFullScreenContentWithError:(NSError *)error;
- (void)adWillPresentFullScreenContent:(id<GADFullScreenPresentingAd>)ad;
- (void)adDidRecordImpression:(id<GADFullScreenPresentingAd>)ad;
- (void)adDidRecordClick:(id<GADFullScreenPresentingAd>)ad;
@end

// --- GADBannerView ---
@interface GADBannerView : UIView
- (instancetype)initWithAdSize:(GADAdSize)adSize;
@property(nonatomic, copy) NSString *adUnitID;
@property(nonatomic, weak) UIViewController *rootViewController;
- (void)loadRequest:(GADRequest *)request;
@end

// --- GADInterstitialAd ---
@interface GADInterstitialAd : NSObject <GADFullScreenPresentingAd>
@property(nonatomic, weak) id<GADFullScreenContentDelegate> fullScreenContentDelegate;
+ (void)loadWithAdUnitID:(NSString *)adUnitID
                 request:(GADRequest *)request
       completionHandler:(void (^)(GADInterstitialAd *_Nullable, NSError *_Nullable))completionHandler;
- (void)presentFromRootViewController:(UIViewController *)rootViewController;
@end

// --- GADAppOpenAd ---
@interface GADAppOpenAd : NSObject <GADFullScreenPresentingAd>
@property(nonatomic, weak) id<GADFullScreenContentDelegate> fullScreenContentDelegate;
+ (void)loadWithAdUnitID:(NSString *)adUnitID
                 request:(GADRequest *)request
       completionHandler:(void (^)(GADAppOpenAd *_Nullable, NSError *_Nullable))completionHandler;
- (void)presentFromRootViewController:(UIViewController *)rootViewController;
@end

// --- GADInitializationStatus ---
@interface GADInitializationStatus : NSObject
@end

// --- GADMobileAds ---
@interface GADMobileAds : NSObject
+ (GADMobileAds *)sharedInstance;
- (void)startWithCompletionHandler:(void (^_Nullable)(GADInitializationStatus *_Nonnull status))completionHandler;
@end
