package br.com.codecacto.kmplib.platform

import kotlinx.cinterop.ExperimentalForeignApi
import kotlinx.cinterop.addressOf
import kotlinx.cinterop.usePinned
import kotlinx.coroutines.suspendCancellableCoroutine
import platform.Foundation.NSData
import platform.Foundation.NSURL
import platform.Foundation.dataWithContentsOfURL
import platform.UIKit.UIApplication
import platform.UIKit.UIDocumentPickerDelegateProtocol
import platform.UIKit.UIDocumentPickerViewController
import platform.UIKit.UIImagePickerController
import platform.UIKit.UIImagePickerControllerCameraCaptureMode
import platform.UIKit.UIImagePickerControllerDelegateProtocol
import platform.UIKit.UIImagePickerControllerSourceType
import platform.UIKit.UINavigationControllerDelegateProtocol
import platform.darwin.NSObject
import kotlin.coroutines.resume

actual fun getFilePicker(): FilePicker {
    return IosFilePicker()
}

@OptIn(ExperimentalForeignApi::class)
class IosFilePicker : FilePicker {

    override suspend fun pickImage(): FileData? {
        return suspendCancellableCoroutine { continuation ->
            val rootViewController = UIApplication.sharedApplication.keyWindow?.rootViewController
                ?: run {
                    continuation.resume(null)
                    return@suspendCancellableCoroutine
                }

            val picker = UIImagePickerController()
            picker.sourceType = UIImagePickerControllerSourceType.UIImagePickerControllerSourceTypePhotoLibrary

            val delegate = object : NSObject(), UIImagePickerControllerDelegateProtocol,
                UINavigationControllerDelegateProtocol {

                override fun imagePickerController(
                    picker: UIImagePickerController,
                    didFinishPickingMediaWithInfo: Map<Any?, *>
                ) {
                    picker.dismissViewControllerAnimated(true, null)

                    val imageUrl = didFinishPickingMediaWithInfo[platform.UIKit.UIImagePickerControllerImageURL] as? NSURL

                    imageUrl?.let { url ->
                        val fileData = urlToFileData(url)
                        continuation.resume(fileData)
                    } ?: continuation.resume(null)
                }

                override fun imagePickerControllerDidCancel(picker: UIImagePickerController) {
                    picker.dismissViewControllerAnimated(true, null)
                    continuation.resume(null)
                }
            }

            picker.delegate = delegate
            rootViewController.presentViewController(picker, true, null)
        }
    }

    override suspend fun pickMultipleImages(maxCount: Int): List<FileData> {
        // iOS não suporta seleção múltipla de imagens nativamente com UIImagePickerController
        // Precisaria usar PHPickerViewController (iOS 14+)
        // Por ora, retorna lista vazia
        return emptyList()
    }

    override suspend fun pickFile(mimeTypes: List<String>): FileData? {
        return suspendCancellableCoroutine { continuation ->
            val rootViewController = UIApplication.sharedApplication.keyWindow?.rootViewController
                ?: run {
                    continuation.resume(null)
                    return@suspendCancellableCoroutine
                }

            // Converter MIME types para UTTypes
            val utTypes = mimeTypes.map { mimeTypeToUTType(it) }

            val picker = UIDocumentPickerViewController(
                documentTypes = utTypes,
                inMode = platform.UIKit.UIDocumentPickerMode.UIDocumentPickerModeImport
            )

            val delegate = object : NSObject(), UIDocumentPickerDelegateProtocol {
                override fun documentPicker(
                    controller: UIDocumentPickerViewController,
                    didPickDocumentsAtURLs: List<*>
                ) {
                    val url = didPickDocumentsAtURLs.firstOrNull() as? NSURL
                    url?.let {
                        val fileData = urlToFileData(it)
                        continuation.resume(fileData)
                    } ?: continuation.resume(null)
                }

                override fun documentPickerWasCancelled(controller: UIDocumentPickerViewController) {
                    continuation.resume(null)
                }
            }

            picker.delegate = delegate
            rootViewController.presentViewController(picker, true, null)
        }
    }

    override suspend fun pickMultipleFiles(mimeTypes: List<String>, maxCount: Int): List<FileData> {
        return suspendCancellableCoroutine { continuation ->
            val rootViewController = UIApplication.sharedApplication.keyWindow?.rootViewController
                ?: run {
                    continuation.resume(emptyList())
                    return@suspendCancellableCoroutine
                }

            val utTypes = mimeTypes.map { mimeTypeToUTType(it) }

            val picker = UIDocumentPickerViewController(
                documentTypes = utTypes,
                inMode = platform.UIKit.UIDocumentPickerMode.UIDocumentPickerModeImport
            )
            picker.allowsMultipleSelection = true

            val delegate = object : NSObject(), UIDocumentPickerDelegateProtocol {
                override fun documentPicker(
                    controller: UIDocumentPickerViewController,
                    didPickDocumentsAtURLs: List<*>
                ) {
                    val urls = didPickDocumentsAtURLs.filterIsInstance<NSURL>()
                    val files = urls.mapNotNull { urlToFileData(it) }

                    val result = if (maxCount > 0) files.take(maxCount) else files
                    continuation.resume(result)
                }

                override fun documentPickerWasCancelled(controller: UIDocumentPickerViewController) {
                    continuation.resume(emptyList())
                }
            }

            picker.delegate = delegate
            rootViewController.presentViewController(picker, true, null)
        }
    }

    override suspend fun takePhoto(): FileData? {
        return suspendCancellableCoroutine { continuation ->
            val rootViewController = UIApplication.sharedApplication.keyWindow?.rootViewController
                ?: run {
                    continuation.resume(null)
                    return@suspendCancellableCoroutine
                }

            val picker = UIImagePickerController()
            picker.sourceType = UIImagePickerControllerSourceType.UIImagePickerControllerSourceTypeCamera
            picker.cameraCaptureMode = UIImagePickerControllerCameraCaptureMode.UIImagePickerControllerCameraCaptureModePhoto

            val delegate = object : NSObject(), UIImagePickerControllerDelegateProtocol,
                UINavigationControllerDelegateProtocol {

                override fun imagePickerController(
                    picker: UIImagePickerController,
                    didFinishPickingMediaWithInfo: Map<Any?, *>
                ) {
                    picker.dismissViewControllerAnimated(true, null)

                    val imageUrl = didFinishPickingMediaWithInfo[platform.UIKit.UIImagePickerControllerImageURL] as? NSURL

                    imageUrl?.let { url ->
                        val fileData = urlToFileData(url)
                        continuation.resume(fileData)
                    } ?: continuation.resume(null)
                }

                override fun imagePickerControllerDidCancel(picker: UIImagePickerController) {
                    picker.dismissViewControllerAnimated(true, null)
                    continuation.resume(null)
                }
            }

            picker.delegate = delegate
            rootViewController.presentViewController(picker, true, null)
        }
    }

    private fun urlToFileData(url: NSURL): FileData? {
        return try {
            val data = NSData.dataWithContentsOfURL(url) ?: return null

            val name = url.lastPathComponent ?: "file"
            val extension = url.pathExtension ?: ""
            val mimeType = extensionToMimeType(extension)

            // Converter NSData para ByteArray
            val byteArray = ByteArray(data.length.toInt())
            data.bytes?.let { bytes ->
                byteArray.usePinned { pinned ->
                    platform.posix.memcpy(pinned.addressOf(0), bytes, data.length)
                }
            }

            FileData(
                name = name,
                mimeType = mimeType,
                data = byteArray,
                size = data.length.toLong()
            )
        } catch (e: Exception) {
            null
        }
    }

    private fun mimeTypeToUTType(mimeType: String): String {
        return when {
            mimeType.startsWith("image/") -> "public.image"
            mimeType.startsWith("video/") -> "public.video"
            mimeType.startsWith("audio/") -> "public.audio"
            mimeType == "application/pdf" -> "com.adobe.pdf"
            mimeType.contains("text") -> "public.text"
            else -> "public.data"
        }
    }

    private fun extensionToMimeType(extension: String): String {
        return when (extension.lowercase()) {
            "jpg", "jpeg" -> "image/jpeg"
            "png" -> "image/png"
            "gif" -> "image/gif"
            "webp" -> "image/webp"
            "pdf" -> "application/pdf"
            "txt" -> "text/plain"
            "mp4" -> "video/mp4"
            "mp3" -> "audio/mpeg"
            "zip" -> "application/zip"
            else -> "application/octet-stream"
        }
    }
}
