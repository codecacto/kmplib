-- =============================================================================
-- Schema genérico de sync offline-first (T1a — kmplib 2.30.0)
-- Agnóstico de domínio: uma única tabela-espelho para QUALQUER entidade.
-- O app registra suas SyncableEntity<T> e serializa o modelo em payload_json.
--
-- v4 (kmplib 2.94.0):
--   * rejections / reject_code / reject_error — HISTÓRICO DE ENTREGA
--     (GAP-KL-M-RESTCRUD-REJECTHISTORY). `failed`/`fail_code`/`last_error` descrevem o
--     estado ATUAL da falha e são (corretamente) limpos por uma escrita nova do usuário;
--     estas três colunas descrevem o que o servidor JÁ disse sobre a linha e **sobrevivem**
--     a essa escrita. Sem elas, qualquer toque posterior apagava a prova de que o registro
--     tinha sido recusado: a linha virava "pendência nova legítima" e a conferência do app
--     a dava por boa — no "Todos a Bordo", "Tudo certo!" com o servidor sem registro nenhum
--     daquela criança.
--
-- v3 (kmplib 2.93.0):
--   * sync_id_remap — REMAP DURÁVEL `clientId → serverId`
--     (GAP-KL-M-RESTCRUD-IDMIGRATION). O remap só existia dentro de UM ciclo de sync
--     (variável local do RestCrudSyncEngine): um filho que não drenasse junto do pai
--     perdia a tradução e subia a FK apontando para o id local → 4xx → `Failed` para
--     sempre. Agora a tradução é gravada no mesmo instante em que o id migra e sobrevive
--     a ciclos, a reinício de processo e a drenagem parcial.
--   * índice por client_id — `client_id` virou ÂNCORA PERMANENTE da linha (deixou de ser
--     sobrescrito pelo id do servidor), e é por ele que a UI reencontra o registro depois
--     de o id migrar de local para servidor.
--
-- v2 (kmplib 2.91.0):
--   * account_id  — ESCOPO DE CONTA (GAP-KL-M-SYNC-ACCOUNTSCOPE). Sem ele, trocar de
--     usuário no mesmo aparelho vazava dado entre contas na leitura E, pior, no push
--     (a outbox de A subia inteira para a conta de B). Faz parte da PK: cada conta tem
--     o SEU espelho e a SUA outbox, isoladas — trocar de conta e voltar preserva as duas.
--     '' (string vazia) = bucket "sem escopo" (base legada, pré-migração).
--   * failed / fail_code / attempts — ESTADO DE ESCRITA POR LINHA
--     (GAP-KL-M-RESTCRUD-LOCALFIRST): distingue "pendente, vai retentar" de "o servidor
--     RECUSOU" (4xx terminal), preservando o erro para o app exibir. Sem isso, o motor
--     retentava para sempre uma linha que nunca seria aceita, ou perdia a escrita.
-- =============================================================================

-- Espelho local de uma entidade sincronizável.
--  account_id     : conta dona da linha ('' = sem escopo/legado). Parte da PK.
--  entity         : nome lógico da entidade (ex.: "frete", "caminhao").
--  local_id       : id local estável (== client_id no nascimento; PK composta).
--  server_id      : id atribuído pelo servidor (NULL até o 1º push aceito).
--  client_id      : uuid gerado no cliente (idempotência ponta a ponta).
--  payload_json   : modelo serializado (JSON do DTO por-papel do app).
--  updated_at     : updatedAt canônico do servidor (ISO-8601) ou local provisório.
--  dirty          : 1 = há mudança local pendente de push.
--  pending_op     : "create" | "update" | "delete" enquanto dirty; NULL após drenar.
--  deleted        : 1 = tombstone (exclusão lógica até confirmar no servidor).
--  base_updated_at: updatedAt-base p/ detecção de conflito (LWW server-side).
--
--  ESTADO ATUAL DA FALHA (limpo por uma escrita nova do usuário — ela substitui a recusa):
--  last_error     : último erro de sync do item (NULL se ok).
--  failed         : 1 = o servidor RECUSOU de forma terminal (4xx) — NÃO retentar sozinho.
--  fail_code      : código HTTP (ou sentinela) da recusa terminal; NULL se não falhou.
--
--  HISTÓRICO DE ENTREGA (NÃO é limpo por escrita do usuário; só quando o servidor ACEITA):
--  attempts       : tentativas de push já feitas para esta linha.
--  rejections     : quantas vezes o servidor recusou esta linha de forma terminal (ou por cota).
--  reject_code    : código da ÚLTIMA recusa; sobrevive ao toque seguinte do usuário.
--  reject_error   : mensagem da ÚLTIMA recusa; sobrevive ao toque seguinte do usuário.
CREATE TABLE synced_entity (
    account_id      TEXT    NOT NULL DEFAULT '',
    entity          TEXT    NOT NULL,
    local_id        TEXT    NOT NULL,
    server_id       TEXT,
    client_id       TEXT    NOT NULL,
    payload_json    TEXT    NOT NULL,
    updated_at      TEXT,
    dirty           INTEGER NOT NULL DEFAULT 0,
    pending_op      TEXT,
    deleted         INTEGER NOT NULL DEFAULT 0,
    base_updated_at TEXT,
    last_error      TEXT,
    failed          INTEGER NOT NULL DEFAULT 0,
    fail_code       INTEGER,
    attempts        INTEGER NOT NULL DEFAULT 0,
    rejections      INTEGER NOT NULL DEFAULT 0,
    reject_code     INTEGER,
    reject_error    TEXT,
    PRIMARY KEY (account_id, entity, local_id)
);

CREATE INDEX synced_entity_dirty ON synced_entity(account_id, entity, dirty);
CREATE INDEX synced_entity_server ON synced_entity(account_id, entity, server_id);
-- `client_id` é a âncora PERMANENTE da linha (nunca é sobrescrito pelo id do servidor):
-- é por ele que a UI reencontra o registro depois de o id migrar de local para servidor.
CREATE INDEX synced_entity_client ON synced_entity(account_id, entity, client_id);

-- Remap DURÁVEL `clientId → serverId` (kmplib 2.93.0).
-- Gravado no exato instante em que um id local migra para o id do servidor (markSynced) e
-- mantido depois disso: é a única forma de um FILHO que drena em OUTRO ciclo (ou depois de o
-- processo morrer) traduzir a FK do pai. `client_id` é globalmente único no aparelho
-- (`newRestClientId`), por isso a PK não inclui a entidade — a resolução é cross-entity, que é
-- exatamente o caso de uso (o filho resolve o id do PAI, de outra entidade).
--  account_id : conta dona do mapeamento (mesmo escopo do espelho).
--  client_id  : id local com que o registro nasceu neste aparelho.
--  server_id  : id atribuído pelo servidor quando o registro foi aceito.
--  entity     : entidade de origem (diagnóstico; não participa da chave).
CREATE TABLE sync_id_remap (
    account_id TEXT NOT NULL DEFAULT '',
    client_id  TEXT NOT NULL,
    server_id  TEXT NOT NULL,
    entity     TEXT NOT NULL,
    PRIMARY KEY (account_id, client_id)
);

CREATE INDEX sync_id_remap_server ON sync_id_remap(account_id, server_id);

-- Cursor de paginação/delta por entidade (avança após cada pull aplicado).
-- Escopado por conta pelo mesmo motivo do espelho: o cursor de A não vale para B.
CREATE TABLE sync_cursor (
    account_id TEXT NOT NULL DEFAULT '',
    entity     TEXT NOT NULL,
    cursor     TEXT,
    PRIMARY KEY (account_id, entity)
);

-- ---------------------------------------------------------------------------
-- Leitura reativa (Flow) — espelho visível: não-deletados de uma entidade.
-- ---------------------------------------------------------------------------
selectAllVisible:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND deleted = 0
ORDER BY updated_at DESC;

selectVisibleById:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId AND deleted = 0;

selectByLocalId:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

selectByServerId:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND server_id = :serverId;

selectByClientId:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND client_id = :clientId;

-- ---------------------------------------------------------------------------
-- HANDLE ESTÁVEL (kmplib 2.93.0)
--
-- O id que o app carrega na navegação **não migra**: a linha é reencontrada por
-- `local_id` OU `client_id` OU `server_id`. Antes, uma tela aberta com o id local de um
-- registro criado offline ficava vazia assim que o drain migrava o id (a consulta por
-- `local_id` deixava de casar) — e a conferência final passava a calcular sobre lista vazia.
-- `ORDER BY` torna a escolha determinística quando mais de uma coluna casa.
-- ---------------------------------------------------------------------------
selectVisibleByHandle:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND deleted = 0
  AND (local_id = :handle OR client_id = :handle OR server_id = :handle)
ORDER BY (local_id = :handle) DESC, (server_id = :handle) DESC
LIMIT 1;

selectByHandle:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity
  AND (local_id = :handle OR client_id = :handle OR server_id = :handle)
ORDER BY (local_id = :handle) DESC, (server_id = :handle) DESC
LIMIT 1;

-- Outbox: itens sujos (pendentes de push) de uma entidade, mais antigos primeiro.
selectDirty:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND dirty = 1
ORDER BY updated_at ASC;

-- Outbox DRENÁVEL: sujos que ainda não foram recusados de forma terminal pelo servidor.
-- É o que o push consome — uma linha `failed = 1` só volta por retry EXPLÍCITO do app.
selectDrainable:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND dirty = 1 AND failed = 0
ORDER BY updated_at ASC;

-- Linhas recusadas pelo servidor (4xx terminal) — a UI mostra e oferece nova tentativa.
selectFailed:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND failed = 1
ORDER BY updated_at ASC;

-- Outbox global (todas as entidades da conta) — usado pela fila visível do SyncEngine.
selectAllDirty:
SELECT *
FROM synced_entity
WHERE account_id = :accountId AND dirty = 1
ORDER BY updated_at ASC;

countDirty:
SELECT COUNT(*) FROM synced_entity WHERE account_id = :accountId AND dirty = 1;

-- Linhas de UMA entidade em TODAS as contas (kmplib 2.104.0). ÚNICA consulta que ignora o escopo,
-- e por um motivo específico: o dono de binários no disco (BlobStore/RestUploadOutbox) precisa saber
-- quais arquivos ainda são referenciados por ALGUMA conta antes de varrer órfãos. Varrer olhando só
-- a conta corrente apagaria as fotos ainda não enviadas de quem trocou de usuário no aparelho.
-- NÃO usar para leitura de domínio — o isolamento por conta continua valendo em todo o resto.
selectEntityAllAccounts:
SELECT *
FROM synced_entity
WHERE entity = :entity;

-- Quantas linhas ainda estão no bucket legado (sem escopo de conta).
countLegacy:
SELECT COUNT(*) FROM synced_entity WHERE account_id = '';

-- ---------------------------------------------------------------------------
-- Escrita
-- ---------------------------------------------------------------------------
-- NOTA (2.94.0): esta escrita é DELIBERADAMENTE burra — grava o que o chamador mandou,
-- inclusive as colunas de histórico. Quem decide o que preservar entre escritas é o
-- `RestEntityMirror` (`putDirty` carrega o histórico da linha; `writeClean` o zera, porque o
-- servidor aceitou). Concentrar a política no Kotlin a torna testável e documentada num lugar
-- só, em vez de dividida entre a SQL e o chamador.
upsert:
INSERT INTO synced_entity (
    account_id, entity, local_id, server_id, client_id, payload_json,
    updated_at, dirty, pending_op, deleted, base_updated_at, last_error,
    failed, fail_code, attempts, rejections, reject_code, reject_error
) VALUES (
    :accountId, :entity, :localId, :serverId, :clientId, :payloadJson,
    :updatedAt, :dirty, :pendingOp, :deleted, :baseUpdatedAt, :lastError,
    :failed, :failCode, :attempts, :rejections, :rejectCode, :rejectError
)
ON CONFLICT(account_id, entity, local_id) DO UPDATE SET
    server_id       = excluded.server_id,
    client_id       = excluded.client_id,
    payload_json    = excluded.payload_json,
    updated_at      = excluded.updated_at,
    dirty           = excluded.dirty,
    pending_op      = excluded.pending_op,
    deleted         = excluded.deleted,
    base_updated_at = excluded.base_updated_at,
    last_error      = excluded.last_error,
    failed          = excluded.failed,
    fail_code       = excluded.fail_code,
    attempts        = excluded.attempts,
    rejections      = excluded.rejections,
    reject_code     = excluded.reject_code,
    reject_error    = excluded.reject_error;

-- O servidor ACEITOU: o histórico de entrega cumpriu o seu papel e é zerado junto com o
-- estado de falha. É o ÚNICO ponto que apaga a evidência de recusa — de propósito.
markClean:
UPDATE synced_entity
SET dirty = 0, pending_op = NULL, last_error = NULL, failed = 0, fail_code = NULL, attempts = 0,
    rejections = 0, reject_code = NULL, reject_error = NULL,
    server_id = :serverId, updated_at = :updatedAt, base_updated_at = :baseUpdatedAt
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

setError:
UPDATE synced_entity
SET last_error = :lastError
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

-- Recusa TERMINAL do servidor: a linha para de ser drenada e passa a ser visível como
-- "não salva" para o app (com o erro preservado). Também reexibe um delete recusado
-- (deleted = 0) — o registro continua existindo no servidor.
-- Grava nas DUAS camadas: estado atual (failed/fail_code/last_error) E histórico
-- (rejections/reject_code/reject_error), que sobrevive ao próximo toque do usuário.
markFailed:
UPDATE synced_entity
SET failed = 1, fail_code = :failCode, last_error = :lastError,
    attempts = attempts + 1, deleted = 0,
    rejections = rejections + 1, reject_code = :failCode, reject_error = :lastError
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

-- Retry explícito: volta a linha para a outbox drenável, preservando o payload.
-- NÃO mexe no histórico: pedir "tentar de novo" não apaga o fato de ter sido recusada — sem
-- isso, um reenvio sem sinal transformaria a marcação recusada em pendência confiável.
clearFailed:
UPDATE synced_entity
SET failed = 0, fail_code = NULL, last_error = NULL
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

-- Falha RETENTÁVEL (5xx/timeout/rede): conta a tentativa e guarda o erro, sem sair da outbox.
bumpAttempt:
UPDATE synced_entity
SET attempts = attempts + 1, last_error = :lastError
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

deleteHard:
DELETE FROM synced_entity
WHERE account_id = :accountId AND entity = :entity AND local_id = :localId;

-- Apaga TUDO, de TODAS as contas (wipe do aparelho).
deleteAll:
DELETE FROM synced_entity;

-- Apaga o espelho + outbox de UMA conta (exclusão de conta/LGPD) — as demais ficam intactas.
deleteAccount:
DELETE FROM synced_entity WHERE account_id = :accountId;

-- Adoção única do bucket legado (base criada antes do escopo de conta existir).
adoptLegacy:
UPDATE OR REPLACE synced_entity SET account_id = :accountId WHERE account_id = '';

-- ---------------------------------------------------------------------------
-- Remap durável clientId → serverId
-- ---------------------------------------------------------------------------
rememberRemap:
INSERT INTO sync_id_remap (account_id, client_id, server_id, entity)
VALUES (:accountId, :clientId, :serverId, :entity)
ON CONFLICT(account_id, client_id) DO UPDATE SET
    server_id = excluded.server_id,
    entity    = excluded.entity;

selectRemapByClientId:
SELECT server_id FROM sync_id_remap WHERE account_id = :accountId AND client_id = :clientId;

selectRemapByServerId:
SELECT client_id FROM sync_id_remap WHERE account_id = :accountId AND server_id = :serverId;

countRemap:
SELECT COUNT(*) FROM sync_id_remap WHERE account_id = :accountId;

forgetRemap:
DELETE FROM sync_id_remap WHERE account_id = :accountId AND client_id = :clientId;

clearRemap:
DELETE FROM sync_id_remap;

deleteAccountRemap:
DELETE FROM sync_id_remap WHERE account_id = :accountId;

adoptLegacyRemap:
UPDATE OR REPLACE sync_id_remap SET account_id = :accountId WHERE account_id = '';

-- ---------------------------------------------------------------------------
-- Cursor
-- ---------------------------------------------------------------------------
getCursor:
SELECT cursor FROM sync_cursor WHERE account_id = :accountId AND entity = :entity;

setCursor:
INSERT INTO sync_cursor (account_id, entity, cursor) VALUES (:accountId, :entity, :cursor)
ON CONFLICT(account_id, entity) DO UPDATE SET cursor = excluded.cursor;

clearCursors:
DELETE FROM sync_cursor;

deleteAccountCursors:
DELETE FROM sync_cursor WHERE account_id = :accountId;

adoptLegacyCursors:
UPDATE OR REPLACE sync_cursor SET account_id = :accountId WHERE account_id = '';
