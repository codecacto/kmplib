# ============================================================
# Fastfile Compartilhado - CodeCacto
#
# Lanes reutilizáveis para todos os apps KMP.
# Cada app importa este arquivo via import_from_git.
#
# Uso no app:
#   import_from_git(
#     url: 'https://github.com/codecacto/kmplib.git',
#     branch: 'main',
#     path: 'ci/fastlane/Fastfile'
#   )
# ============================================================

default_platform(:android)

# ==================== ANDROID ====================

platform :android do

  desc "Deploy AAB para Google Play Store"
  desc "Parâmetros: track, rollout, aab_path, json_key_path, package_name"
  lane :deploy do |options|
    track = options[:track] || "internal"
    rollout = options[:rollout] || "1.0"
    aab_path = options[:aab_path] || Dir.glob("**/bundle/release/*.aab").first
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    UI.user_error!("AAB não encontrado em: #{aab_path}") unless aab_path && File.exist?(aab_path)
    UI.user_error!("Service account JSON não encontrado") unless File.exist?(json_key_path)

    upload_to_play_store(
      track: track,
      aab: aab_path,
      json_key: json_key_path,
      package_name: package_name,
      rollout: track == "production" ? rollout.to_f.to_s : nil,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: track == "production" ? "inProgress" : "completed"
    )

    UI.success("Android deploy concluído: track=#{track}")
  end

  desc "Promover release entre tracks"
  desc "Parâmetros: from_track, to_track, rollout, json_key_path, package_name"
  lane :promote do |options|
    from_track = options[:from_track] || "internal"
    to_track = options[:to_track] || "production"
    rollout = options[:rollout] || "0.01"
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    upload_to_play_store(
      track: from_track,
      track_promote_to: to_track,
      json_key: json_key_path,
      package_name: package_name,
      rollout: rollout.to_f.to_s,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Promovido: #{from_track} → #{to_track} (#{(rollout.to_f * 100).to_i}%)")
  end

  desc "Halt rollout no Play Store"
  desc "Parâmetros: track, json_key_path, package_name"
  lane :halt do |options|
    track = options[:track] || "production"
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    upload_to_play_store(
      track: track,
      json_key: json_key_path,
      package_name: package_name,
      track_promote_release_status: "halted",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Rollout parado: track=#{track}")
  end

end

# ==================== iOS ====================

platform :ios do

  desc "Build e upload para TestFlight"
  desc "Parâmetros: scheme, xcode_project, use_workspace, workspace_path, marketing_version, build_number, asc_key_id, asc_issuer_id, submit_for_review"
  lane :release do |options|
    scheme = options[:scheme] || "iosApp"
    marketing_version = options[:marketing_version] || ENV["MARKETING_VERSION"]
    build_number = options[:build_number] || ENV["BUILD_NUMBER"]
    asc_key_id = options[:asc_key_id] || ENV["ASC_KEY_ID"]
    asc_issuer_id = options[:asc_issuer_id] || ENV["ASC_ISSUER_ID"]
    submit_for_review = options[:submit_for_review].to_s == "true"

    use_workspace = options[:use_workspace].to_s == "true"
    workspace_path = options[:workspace_path] || "iosApp/iosApp.xcworkspace"
    xcode_project = options[:xcode_project] || "iosApp/iosApp.xcodeproj"

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: "private_keys/AuthKey_#{asc_key_id}.p8"
    )

    if marketing_version
      increment_version_number_in_xcodeproj(
        version_number: marketing_version,
        xcodeproj: xcode_project
      )
    end

    if build_number
      increment_build_number_in_xcodeproj(
        build_number: build_number,
        xcodeproj: xcode_project
      )
    end

    build_params = {
      scheme: scheme,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {}
      },
      clean: true,
      output_directory: "./build",
      output_name: "#{scheme}.ipa"
    }

    if use_workspace
      build_params[:workspace] = workspace_path
    else
      build_params[:project] = xcode_project
    end

    build_app(**build_params)

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      submit_beta_review: false
    )

    if submit_for_review
      deliver(
        api_key: api_key,
        skip_binary_upload: true,
        submit_for_review: true,
        phased_release: true,
        automatic_release: false,
        force: true
      )
    end

    UI.success("iOS deploy concluído: TestFlight upload OK")
  end

  desc "Submeter build existente para App Store com phased release"
  desc "Parâmetros: asc_key_id, asc_issuer_id"
  lane :submit_appstore do |options|
    asc_key_id = options[:asc_key_id] || ENV["ASC_KEY_ID"]
    asc_issuer_id = options[:asc_issuer_id] || ENV["ASC_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: "private_keys/AuthKey_#{asc_key_id}.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      submit_for_review: true,
      phased_release: true,
      automatic_release: false,
      force: true
    )

    UI.success("Submetido para review com phased release")
  end

end
