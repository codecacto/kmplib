# ============================================================
# Fastfile Compartilhado - CodeCacto
#
# Lanes reutilizáveis para todos os apps KMP.
# Cada app importa este arquivo via import_from_git.
#
# Uso no app:
#   import_from_git(
#     url: 'https://github.com/codecacto/kmplib.git',
#     branch: 'main',
#     path: 'ci/fastlane/Fastfile'
#   )
# ============================================================

default_platform(:android)

# ==================== ANDROID ====================

platform :android do

  desc "Deploy AAB para Google Play Store"
  desc "Parâmetros: track, rollout, aab_path, json_key_path, package_name"
  lane :deploy do |options|
    track = options[:track] || "internal"
    rollout = options[:rollout] || "1.0"
    aab_path = options[:aab_path] || Dir.glob("**/bundle/release/*.aab").first
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    UI.user_error!("AAB não encontrado em: #{aab_path}") unless aab_path && File.exist?(aab_path)
    UI.user_error!("Service account JSON não encontrado") unless File.exist?(json_key_path)

    upload_to_play_store(
      track: track,
      aab: aab_path,
      json_key: json_key_path,
      package_name: package_name,
      rollout: track == "production" ? rollout.to_f.to_s : nil,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: track == "production" ? "inProgress" : "completed"
    )

    UI.success("Android deploy concluído: track=#{track}")
  end

  desc "Promover release entre tracks"
  desc "Parâmetros: from_track, to_track, rollout, json_key_path, package_name"
  lane :promote do |options|
    from_track = options[:from_track] || "internal"
    to_track = options[:to_track] || "production"
    rollout = options[:rollout] || "0.01"
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    upload_to_play_store(
      track: from_track,
      track_promote_to: to_track,
      json_key: json_key_path,
      package_name: package_name,
      rollout: rollout.to_f.to_s,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Promovido: #{from_track} → #{to_track} (#{(rollout.to_f * 100).to_i}%)")
  end

  desc "Halt rollout no Play Store"
  desc "Parâmetros: track, json_key_path, package_name"
  lane :halt do |options|
    track = options[:track] || "production"
    json_key_path = options[:json_key_path] || "play-sa.json"
    package_name = options[:package_name] || ENV["PACKAGE_NAME"]

    upload_to_play_store(
      track: track,
      json_key: json_key_path,
      package_name: package_name,
      track_promote_release_status: "halted",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Rollout parado: track=#{track}")
  end

end

# ==================== iOS ====================

platform :ios do

  # Assinatura pelo `match`, quando disponível — senão, o comportamento de antes.
  #
  # A migração é por app, não de uma vez: um app que ainda não passou pelo `sync_signing … setup:true`
  # continua compilando com a assinatura automática do chaveiro, como sempre compilou. Trocar isso por
  # uma falha dura converteria "ainda não migrei este app" em "a trilha iOS parou", que é o oposto do
  # que este trabalho serve para fazer.
  #
  # Devolve o hash de `provisioningProfiles` para o `build_app`, ou vazio.
  def perfis_do_match(app_identifier, tipo)
    return {} if ENV["MATCH_PASSWORD"].to_s.empty?
    return {} if app_identifier.to_s.empty?

    sync_signing(app_identifier: app_identifier, tipo: tipo)

    # O `match` publica o nome do perfil instalado nesta variável — é o contrato dele com o
    # `build_app`. Ler daqui evita fixar o nome ("match AppStore br.com.x"), que muda de formato
    # entre versões do fastlane e quebraria em silêncio, com o Xcode caindo na assinatura automática.
    nome = ENV["sigh_#{app_identifier}_#{tipo}_profile-name"]
    if nome.to_s.empty?
      UI.important("match rodou mas não publicou o nome do perfil; deixando o Xcode resolver")
      return {}
    end
    { app_identifier => nome }
  end

  # ---------------------------------------------------------------------------------------------
  # NÃO existe lane de METADADOS aqui, e não deve existir (19/ago/2026).
  #
  # A ficha de loja (textos, prints, Data Safety) é publicada pelo `provisioner app apply|
  # screenshots|datasafety`, que lê o `loja.yaml` do projeto e roda NO SERVIDOR — pronto desde
  # 30/jul/2026, disparado pelo painel via `Monitoramento/fabrica/publicar-ficha.sh`.
  #
  # Uma lane `upload_metadata` (fastlane `deliver`) chegou a existir por algumas horas neste dia e
  # foi revertida: além de duplicar a fonte do conteúdo, ela devolveria a publicação da vitrine para
  # dentro de uma dependência de macOS. O fastlane aqui existe para o que EXIGE Mac — assinar e
  # compilar o IPA. Ficha não exige.
  # ---------------------------------------------------------------------------------------------

  desc "Sincroniza certificado e provisioning profile pelo `match`"
  desc "Parâmetros: app_identifier, tipo (appstore|development), setup (true na PRIMEIRA vez)"
  #
  # ## O gap que isto fecha (19/ago/2026)
  #
  # No Android, keystore e senha passaram a viver cifradas no git e o runner as decifra na hora. No
  # iOS não havia equivalente: certificado de distribuição e provisioning profile moravam **só no
  # chaveiro daquele Mac**. Mac formatado, Mac trocado, ou uma segunda máquina — e a trilha iOS
  # inteira volta a ser reconstruída à mão no portal da Apple.
  #
  # O `match` é a resposta padrão do ecossistema, e é o MESMO remédio: gera os artefatos de
  # assinatura e os guarda **cifrados num repositório git privado** (`codecacto/certificates`), de
  # onde toda máquina decifra os mesmos. Some com o "assina na minha máquina e não no CI".
  #
  # ## `readonly` é o default, e isso não é detalhe
  #
  # Sem `readonly`, o `match` CRIA o que faltar — e, no caminho, pode **revogar** o certificado de
  # distribuição em uso. Um certificado revogado invalida os perfis que dependem dele: build em voo
  # no TestFlight quebra, e não há desfazer. Então:
  #
  #   - **build e publicação rodam sempre `readonly: true`** — se faltar artefato, a lane FALHA
  #     dizendo o que falta, em vez de mexer na conta da Apple sozinha;
  #   - **criar é ato explícito**, `setup: true`, feito à mão, com o Mac por perto e sem release
  #     rodando. É a única vez que alguém digita algo.
  #
  # ## O que ele NÃO faz
  #
  # Não renova nada. Certificado da Apple vence, e renovar continua sendo trabalho manual uma vez por
  # ano. O `match` resolve distribuição e reprodutibilidade — não validade.
  lane :sync_signing do |options|
    app_identifier = options[:app_identifier] || ENV["APP_IDENTIFIER"] ||
                     CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    UI.user_error!("sync_signing precisa de app_identifier") if app_identifier.to_s.empty?

    tipo = options[:tipo] || "appstore"
    setup = options[:setup].to_s == "true"
    git_url = options[:git_url] || ENV["MATCH_GIT_URL"] ||
              "git@github-alt:codecacto/certificates.git"

    if ENV["MATCH_PASSWORD"].to_s.empty?
      UI.user_error!(
        "MATCH_PASSWORD ausente. Ela mora cifrada em Ferramentas/qa-runner/secrets/" \
        "match.properties.age e é exportada pelo `qa preparar-maquina` — rode-o antes."
      )
    end

    match(
      type: tipo,
      app_identifier: [app_identifier],
      git_url: git_url,
      storage_mode: "git",
      # A trava que impede o estrago descrito acima. Só cai quando alguém pede `setup: true`.
      readonly: !setup,
      # Sem isto o match tenta abrir o Xcode/keychain de forma interativa e trava um build headless.
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    UI.success("assinatura sincronizada para #{app_identifier} (#{tipo}, readonly=#{!setup})")
  end

  desc "Compila o IPA e PARA — não envia nada"
  desc "Parâmetros: scheme, xcode_project, use_workspace, workspace_path, marketing_version"
  #
  # Existe desde 19/ago/2026 porque o iOS era a única plataforma sem build-só: a lane `release`
  # compila E envia, então "quero ver se o iOS compila" custava um upload para o TestFlight — e
  # queimava um build number na Apple, que não se recupera. O verbo `build` do qa-runner
  # (`alvo: ios-ipa`) chama esta lane.
  #
  # NÃO pede credencial da App Store de propósito. Compilar não precisa falar com a Apple, e exigir
  # `ASC_KEY_ID` aqui faria o build-só herdar o bloqueio do envio — que é exatamente o que esta lane
  # existe para separar. O build number também não é tocado: sem upload não há duplicata a evitar, e
  # incrementá-lo sujaria o repositório a cada tentativa de compilação.
  lane :build do |options|
    scheme = options[:scheme] || "iosApp"
    marketing_version = options[:marketing_version] || ENV["MARKETING_VERSION"]
    use_workspace = options[:use_workspace].to_s == "true"
    workspace_path = options[:workspace_path] || "iosApp/iosApp.xcworkspace"
    xcode_project = options[:xcode_project] || "iosApp/iosApp.xcodeproj"

    if marketing_version
      increment_version_number_in_xcodeproj(
        version_number: marketing_version,
        xcodeproj: xcode_project
      )
    end

    app_id = options[:app_identifier] || ENV["APP_IDENTIFIER"] ||
             CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    perfis = perfis_do_match(app_id, "appstore")

    build_params = {
      scheme: scheme,
      # `app-store` e não `development`: o ponto do build-só é provar que sai o MESMO artefato que
      # o `release` mandaria. Compilar com outro export_method passaria verde e quebraria no envio.
      export_method: "app-store",
      export_options: { provisioningProfiles: perfis },
      clean: true,
      # Combina com o `onde` do alvo `ios-ipa` no qa-runner. Mudar aqui sem mudar lá faz o verbo
      # dizer "compilou mas não deixou .ipa", que parece falha de build e é caminho errado.
      output_directory: "iosApp/build/ipa",
      output_name: "#{scheme}.ipa"
    }

    if use_workspace
      build_params[:workspace] = workspace_path
    else
      build_params[:project] = xcode_project
    end

    build_app(**build_params)

    UI.success("IPA gerado em iosApp/build/ipa — nada foi enviado. Envio é a lane `release`.")
  end

  desc "Build e upload para TestFlight"
  desc "Parâmetros: scheme, xcode_project, use_workspace, workspace_path, marketing_version, build_number, asc_key_id, asc_issuer_id, submit_for_review"
  lane :release do |options|
    scheme = options[:scheme] || "iosApp"
    marketing_version = options[:marketing_version] || ENV["MARKETING_VERSION"]
    build_number = options[:build_number] || ENV["BUILD_NUMBER"]
    asc_key_id = options[:asc_key_id] || ENV["ASC_KEY_ID"]
    asc_issuer_id = options[:asc_issuer_id] || ENV["ASC_ISSUER_ID"]
    submit_for_review = options[:submit_for_review].to_s == "true"

    use_workspace = options[:use_workspace].to_s == "true"
    workspace_path = options[:workspace_path] || "iosApp/iosApp.xcworkspace"
    xcode_project = options[:xcode_project] || "iosApp/iosApp.xcodeproj"

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: "private_keys/AuthKey_#{asc_key_id}.p8"
    )

    if marketing_version
      increment_version_number_in_xcodeproj(
        version_number: marketing_version,
        xcodeproj: xcode_project
      )
    end

    # Build number: NUNCA digitado à mão.
    #
    # Sem `build_number` explícito, resolve pelo TestFlight (último build da versão + 1). Isso é o
    # que permite rodar o release da máquina do fundador — o valor antigo vinha de
    # GITHUB_RUN_NUMBER (ci/scripts/versioning.sh), que não existe fora do CI e caía em 1,
    # fazendo a App Store rejeitar o upload por build duplicado.
    #
    # Espelha o lado Android, onde o gradle-play-publisher resolve o versionCode pela Play API.
    # Ver docs/15-release-mobile-spec.md.
    if build_number.nil? || build_number.to_s.strip.empty?
      app_id = options[:app_identifier] || ENV["APP_IDENTIFIER"] ||
               CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
      latest = begin
        latest_testflight_build_number(
          api_key: api_key,
          app_identifier: app_id,
          version: marketing_version,
          initial_build_number: 0
        )
      rescue => e
        UI.important("Não foi possível ler o último build do TestFlight (#{e.message}); começando em 0.")
        0
      end
      build_number = latest.to_i + 1
      UI.message("Build number resolvido pelo TestFlight: #{build_number}")
    end

    increment_build_number_in_xcodeproj(
      build_number: build_number.to_s,
      xcodeproj: xcode_project
    )

    app_id_release = options[:app_identifier] || ENV["APP_IDENTIFIER"] ||
                     CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    perfis = perfis_do_match(app_id_release, "appstore")

    build_params = {
      scheme: scheme,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: perfis
      },
      clean: true,
      output_directory: "./build",
      output_name: "#{scheme}.ipa"
    }

    if use_workspace
      build_params[:workspace] = workspace_path
    else
      build_params[:project] = xcode_project
    end

    build_app(**build_params)

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      submit_beta_review: false
    )

    if submit_for_review
      deliver(
        api_key: api_key,
        skip_binary_upload: true,
        submit_for_review: true,
        phased_release: true,
        automatic_release: false,
        force: true
      )
    end

    UI.success("iOS deploy concluído: TestFlight upload OK")
  end

  desc "Submeter build existente para App Store com phased release"
  desc "Parâmetros: asc_key_id, asc_issuer_id"
  lane :submit_appstore do |options|
    asc_key_id = options[:asc_key_id] || ENV["ASC_KEY_ID"]
    asc_issuer_id = options[:asc_issuer_id] || ENV["ASC_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: "private_keys/AuthKey_#{asc_key_id}.p8"
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      submit_for_review: true,
      phased_release: true,
      automatic_release: false,
      force: true
    )

    UI.success("Submetido para review com phased release")
  end

end
